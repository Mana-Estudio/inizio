---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada · INIZIO" description="La página que buscas no existe.">
  <section class="page-top px col" style="padding-bottom:var(--sec);gap:40px;min-height:70vh">
    <span class="lbl teca">Error 404</span>
    <h1 class="h" style="--fs:clamp(56px,9vw,144px);--lh:.95">Esta página <em>no existe.</em></h1>
    <div class="row" style="gap:20px 32px;align-items:center">
      <a href="/proyectos/" class="btn">Ver proyectos <span>→</span></a>
      <a href="/" class="link">Volver al inicio</a>
    </div>
  </section>
</Base>
